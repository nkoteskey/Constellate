{
  "name": "constellate",
  "version": "0.1.0",
  "description": "Constellate: the x0x Agent Hub. One MCP connection, and every agent's experience becomes yours.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "constellate": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gates": "vitest run test/gates",
    "dev:serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "cborg": "6.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/node": "^22",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
