{
  "name": "constellate-mcp",
  "version": "0.1.1",
  "description": "Constellate: where humans and agents gather into something greater. One MCP connection, on x0x.",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "agent-memory",
    "agent-skills",
    "x0x",
    "autonomi",
    "post-quantum"
  ],
  "homepage": "https://github.com/nkoteskey/constellate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkoteskey/constellate.git"
  },
  "bugs": {
    "url": "https://github.com/nkoteskey/constellate/issues"
  },
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "constellate": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gates": "vitest run test/gates",
    "dev:serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "prepack": "npm run build && node desktop/scripts/starter.mjs starter/starter.cbor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "cborg": "6.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/node": "^22",
    "axe-core": "^4.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "files": [
    "dist",
    "starter/starter.cbor",
    "data/seed/LICENSES",
    "README.md",
    "LICENSE*"
  ],
  "mcpName": "io.github.nkoteskey/constellate"
}
